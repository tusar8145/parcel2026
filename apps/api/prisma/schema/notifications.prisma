// ───────────────────────────── Notifications ─────────────────────────────
// Templates, toggles, user preferences and gateway settings (modules/notifications).

/// Super-admin overrides of an event's template text and on/off switch. Defaults live in code
/// (modules/notifications/catalog.ts); a missing row or null field means "use the default".
model NotificationTemplate {
  event       String
  channel     OutboxChannel
  enabled     Boolean?
  subject     String?
  body        String?
  html        String?
  updatedById String?       @db.Uuid
  updatedAt   DateTime      @updatedAt

  @@id([event, channel])
  @@map("notification_templates")
}

/// A user's opt-out (or opt-in) for one event on one channel.
model NotificationPreference {
  userId    String        @db.Uuid
  event     String
  channel   OutboxChannel
  enabled   Boolean
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, event, channel])
  @@map("notification_preferences")
}

/// SMS / email gateway settings. Secrets (API keys) are AES-256-GCM encrypted (common/crypto).
model NotificationGateway {
  channel          OutboxChannel @id
  provider         String
  enabled          Boolean       @default(false)
  /// Non-secret settings: sender id, base URL, from address…
  config           Json          @default("{}")
  /// encrypt(JSON.stringify({ apiKey, apiSecret? }))
  secretsEncrypted String?
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastError        String?
  updatedById      String?       @db.Uuid
  updatedAt        DateTime      @updatedAt

  @@map("notification_gateways")
}

/// A person's in-app notifications (the bell in every panel, GET /me/notifications). Written by
/// UserNotificationsService: the in-app copy of the events they get by SMS / email (NotifyService) and
/// staff alerts (SLA breaches, tickets, approvals, KYC, settlements, cash handovers…). Newest first by id.
model UserNotification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  /// Event key: a NotifyService event ("parcel.delivered") or a staff alert ("staff.kyc_review").
  type      String
  title     String
  body      String?
  /// Where clicking it goes, a panel URL such as "/ecommerce-merchant?parcel=PP-261016-4821".
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id(sort: Desc)])
  @@index([userId, readAt])
  @@map("user_notifications")
}

/// A phone signed in to a Delivery Fast app (merchant, rider): its Firebase Cloud Messaging token. In-app
/// notifications of the user are also sent to it as a push. Removed at sign-out or when Firebase says the
/// token is no longer valid.
model PushDevice {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  /// "merchant" or "rider"
  app        String
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// Push notifications through Firebase Cloud Messaging (one row, id "fcm"): the service account, its private
/// key encrypted at rest (super admin › SMS, Email & Push › Gateway Settings).
model PushGateway {
  id                  String    @id @default("fcm")
  enabled             Boolean   @default(false)
  projectId           String?
  clientEmail         String?
  /// encrypt(private_key) of the service account
  privateKeyEncrypted String?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastError           String?
  updatedById         String?   @db.Uuid
  updatedAt           DateTime  @updatedAt

  @@map("push_gateway")
}

/// A message super admin sent as a push (and in-app notification) to many users: kept as the history.
model PushBroadcast {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String
  body        String
  /// ALL (every merchant and rider), MERCHANTS, RIDERS or USERS (the chosen userIds)
  audience    String
  userIds     String[]  @db.Uuid
  /// Users it went to (in-app), phones it was pushed to, and how many pushes Firebase accepted / refused.
  recipients  Int       @default(0)
  devices     Int       @default(0)
  delivered   Int       @default(0)
  failed      Int       @default(0)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([createdAt])
  @@map("push_broadcasts")
}
