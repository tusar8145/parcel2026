    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@delivery-fast/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
