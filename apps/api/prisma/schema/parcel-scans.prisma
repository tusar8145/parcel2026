// ───────────────────────────── Phone scanning (modules/parcel-scans) ─────────────────────────────
// Courier Operations › New orders › "Scan with phone": a modal opens a session with a one-time link
// (QR code). Photos taken on the phone through that link are kept (compressed) and read (OCR) into
// order fields; the rows are edited in the modal, downloaded / re-imported as Excel and submitted
// through the import engine, which links each booked parcel to its photo.

/// A scanning session: alive while its modal is open (the modal keeps extending expiresAt).
model ParcelScanSession {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the link token; the token itself is only in the link.
  tokenHash   String       @unique
  /// The parcel type of every row (one type and merchant per session).
  kind        ImportKind
  merchantId  String?      @db.Uuid
  createdById String       @db.Uuid
  /// Photos received so far (numbers the rows 1, 2, 3…).
  scanCount   Int          @default(0)
  /// The link works until then; closing the modal ends it at once (closedAt).
  expiresAt   DateTime
  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  scans       ParcelScan[]

  @@index([createdById, createdAt])
  @@map("parcel_scan_sessions")
}

enum ParcelScanStatus {
  /// Photo received, being read.
  READING
  /// Read (fields filled where they were found).
  READ
  /// The photo couldn't be read: fields are typed in by hand.
  FAILED
}

/// One parcel of a session: its photo, the text read from it and the order fields.
model ParcelScan {
  id        String            @id @default(uuid(7)) @db.Uuid
  sessionId String            @db.Uuid
  /// 1, 2, 3… in the session.
  number    Int
  /// The compressed photo (none for rows added from an Excel file).
  fileId    String?           @db.Uuid
  status    ParcelScanStatus  @default(READING)
  /// Text read from the photo (OCR).
  text      String?
  /// Order fields by import column key { recipient_phone: "017…" }: read from the photo, then edited.
  cells     Json              @default("{}")
  /// The order booked from this row (import "Scan ID" column), which keeps the photo.
  parcelId  String?           @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  session   ParcelScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  file      StoredFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  parcel    Parcel?           @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@unique([sessionId, number])
  @@index([parcelId])
  @@index([createdAt])
  @@map("parcel_scans")
}

/// Who read a photo: Claude (SCAN_READER=claude) or the local OCR reader.
enum ScanReader {
  CLAUDE
  LOCAL
}

/// One reading of a "Scan with phone" photo, kept for usage and cost (super admin › Operational settings ›
/// Scan with phone usage). Stays when the scan row and its photo are cleaned up.
model ScanReadLog {
  id           String           @id @default(uuid(7)) @db.Uuid
  scanId       String?          @db.Uuid
  sessionId    String?          @db.Uuid
  kind         ImportKind
  merchantId   String?          @db.Uuid
  /// The staff member who opened the session.
  userId       String?          @db.Uuid
  reader       ScanReader
  /// Claude's model (null for the local reader).
  model        String?
  status       ParcelScanStatus
  /// Claude was asked but failed, so the local reader read it.
  fallback     Boolean          @default(false)
  /// Why Claude failed (no secrets).
  error        String?
  /// Fields found.
  fields       Int              @default(0)
  ms           Int              @default(0)
  inputTokens  Int              @default(0)
  cacheRead    Int              @default(0)
  cacheWrite   Int              @default(0)
  outputTokens Int              @default(0)
  /// Estimated from the model's list price (the bill: Anthropic Console › Usage).
  costUsd      Decimal          @default(0) @db.Decimal(12, 6)
  createdAt    DateTime         @default(now())

  @@index([createdAt])
  @@map("scan_read_logs")
}
