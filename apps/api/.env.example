# Copy to .env. Every variable is validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for CORS and links in messages)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://deliveryfast:deliveryfast@localhost:5432/deliveryfast
REDIS_URL=redis://localhost:6379
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# log = print messages to the API log (development). Add real gateways in src/modules/notifications/providers.
SMS_PROVIDER=log
# Development only: include the OTP code in API responses so you can sign in without a phone.
EXPOSE_DEV_OTP=true
FILE_STORAGE_DIR=.data/files
LOG_LEVEL=info
# Run background workers inside this process. Set false on API instances when `npm run worker` runs separately.
RUN_WORKERS=true
# Set true behind a load balancer / reverse proxy so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
# Sign-in, sign-up and OTP requests per client IP per minute. Keep low in production.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Address search for the website (OpenStreetMap Nominatim). The public server allows ~1 request/s
# and requires an identifying User-Agent; self-host or use a provider for production volume.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=DeliveryFast/1.0 (+https://your-domain.example)
# NOMINATIM_EMAIL=ops@your-domain.example
