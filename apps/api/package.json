    "jose": "^6.2.12",
    "nestjs-pino": "^4.6.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "node scripts/dev-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx src/seed/demo.ts",
    "db:seed:geo": "tsx src/seed/geo-bd.ts",
    "db:migrate:geo": "tsx src/seed/geo-bd.ts --migrate-only",
    "db:seed:users": "tsx src/seed/demo-users.ts",
    "db:build:geo": "node scripts/build-geo-bd.mjs",
    "worker": "node dist/worker.js",
    "postinstall": "prisma generate"
  }
}
