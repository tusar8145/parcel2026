// ───────────────────────────── Rider app (modules/rider) ─────────────────────────────
// Live location, pay plans / earnings / payouts, cash handover requests and KYC.

/// Latest known position per rider (one row, replaced on every accepted fix).
model RiderLocation {
  riderId    String   @id @db.Uuid
  lat        Float
  lng        Float
  accuracy   Float // metres
  heading    Float?
  speed      Float? // m/s
  at         DateTime // when the device took the fix
  receivedAt DateTime @default(now())
  rider      Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rider_locations")
}

/// Position history, kept for RIDER_LOCATION_RETENTION_DAYS (purged daily).
model RiderLocationPoint {
  id        String   @id @default(uuid(7)) @db.Uuid
  riderId   String   @db.Uuid
  lat       Float
  lng       Float
  accuracy  Float
  heading   Float?
  speed     Float?
  at        DateTime
  createdAt DateTime @default(now())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([riderId, at]) // replays of a queued fix are ignored
  @@index([at])
  @@map("rider_location_points")
}

enum RiderPayMode {
  PER_PARCEL
  MONTHLY_SALARY
  BOTH
}

/// What a rider is paid. One plan is in force at a time (effectiveTo = null).
model RiderPayPlan {
  id            String         @id @default(uuid(7)) @db.Uuid
  riderId       String         @db.Uuid
  name          String // "Growth", "Custom"…
  mode          RiderPayMode
  ecommerceRate Decimal        @db.Decimal(12, 2) // per delivered parcel
  documentRate  Decimal        @db.Decimal(12, 2)
  parcelRate    Decimal        @db.Decimal(12, 2)
  pickupRate    Decimal        @default(0) @db.Decimal(12, 2) // per completed pickup
  monthlySalary Decimal        @default(0) @db.Decimal(12, 2)
  source        String         @default("manual") // manual | platform-config
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  createdById   String?        @db.Uuid
  createdAt     DateTime       @default(now())
  rider         Rider          @relation(fields: [riderId], references: [id], onDelete: Cascade)
  earnings      RiderEarning[]

  @@index([riderId, effectiveFrom])
  @@map("rider_pay_plans")
}

enum RiderEarningType {
  DELIVERY
  PICKUP
  SALARY
  INCENTIVE
  DEDUCTION
  /// Franchise riders: a parcel returned to its merchant.
  RETURN
}

/// One line of a rider's earnings ledger. Deductions are negative.
model RiderEarning {
  id          String           @id @default(uuid(7)) @db.Uuid
  riderId     String           @db.Uuid
  type        RiderEarningType
  amount      Decimal          @db.Decimal(12, 2)
  /// Makes each source count once: DELIVERY:<parcelId>, PICKUP:<parcelId>, SALARY:<rider>:<period>, ADJ:<uuid>
  sourceKey   String           @unique
  parcelId    String?          @db.Uuid
  trackingId  String?
  serviceLine String? // ecommerce | document | parcel
  description String
  earnedAt    DateTime         @default(now())
  planId      String?          @db.Uuid
  payoutId    String?          @db.Uuid
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  rider       Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)
  plan        RiderPayPlan?    @relation(fields: [planId], references: [id])
  payout      RiderPayout?     @relation(fields: [payoutId], references: [id])

  @@index([riderId, earnedAt])
  @@index([payoutId])
  @@map("rider_earnings")
}

enum RiderPayoutStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// A payout of a rider's unpaid earnings for a period (maker-checker: created → approved → paid).
model RiderPayout {
  id               String            @id @default(uuid(7)) @db.Uuid
  number           String            @unique // RPO-2610-0001
  riderId          String            @db.Uuid
  periodStart      DateTime
  periodEnd        DateTime
  amount           Decimal           @db.Decimal(12, 2)
  status           RiderPayoutStatus @default(DRAFT)
  createdById      String?           @db.Uuid
  approvedById     String?           @db.Uuid
  approvedAt       DateTime?
  paidById         String?           @db.Uuid
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// Paid by a franchise to its own rider (outside Delivery Fast payroll; no ledger entry).
  franchiseId      String?           @db.Uuid
  rider            Rider             @relation(fields: [riderId], references: [id])
  earnings         RiderEarning[]

  @@index([riderId, createdAt])
  @@index([status])
  @@map("rider_payouts")
}

enum CashHandoverRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// A rider asking a hub to receive their COD cash. Hub staff complete it with POST /cod/handovers.
model CashHandoverRequest {
  id            String                    @id @default(uuid(7)) @db.Uuid
  riderId       String                    @db.Uuid
  hubId         String                    @db.Uuid
  amount        Decimal                   @db.Decimal(12, 2)
  collectionIds String[]                  @db.Uuid
  status        CashHandoverRequestStatus @default(PENDING)
  note          String?
  handoverId    String?                   @unique @db.Uuid
  createdAt     DateTime                  @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?
  rider         Rider                     @relation(fields: [riderId], references: [id])
  hub           Hub                       @relation(fields: [hubId], references: [id])
  handover      CashHandover?             @relation(fields: [handoverId], references: [id])

  @@index([hubId, status])
  @@index([riderId, status])
  @@map("cash_handover_requests")
}

enum RiderKycStatus {
  NOT_STARTED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// A rider's onboarding / KYC state. Riders without a row haven't started KYC.
model RiderOnboarding {
  riderId       String         @id @db.Uuid
  status        RiderKycStatus @default(DOCUMENTS_PENDING)
  applicationId String?        @db.Uuid // the rider application that started it, if any
  startedAt     DateTime       @default(now())
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?        @db.Uuid
  note          String?
  updatedAt     DateTime       @updatedAt
  rider         Rider          @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("rider_onboarding")
}

enum KycDocumentType {
  NID_FRONT
  NID_BACK
  DRIVING_LICENSE
  PHOTO
  VEHICLE_PAPERS
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model RiderKycDocument {
  id              String            @id @default(uuid(7)) @db.Uuid
  riderId         String            @db.Uuid
  type            KycDocumentType
  fileId          String            @db.Uuid
  documentNumber  String?
  expiresAt       DateTime?
  status          KycDocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?           @db.Uuid
  reviewedAt      DateTime?
  supersededAt    DateTime? // replaced by a newer upload of the same type
  createdAt       DateTime          @default(now())
  rider           Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  file            StoredFile        @relation(fields: [fileId], references: [id])

  @@index([riderId, type])
  @@map("rider_kyc_documents")
}
