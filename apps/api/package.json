{
  "name": "@delivery-fast/api",
  "private": true,
  "version": "0.1.0",
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
