// ───────────── Service packages & pricing ─────────────
// docs/architecture-contracts.md "Service packages & pricing"; the service catalog and price fields
// are in packages/shared/src/packages.ts.

enum PackageStatus {
  ACTIVE
  ARCHIVED
}

/// A service plan for one segment: which services its merchants / customers may use and its prices (versions).
model ServicePackage {
  id          String                  @id @default(uuid(7)) @db.Uuid
  segment     Segment
  name        String
  description String?
  /// Set on the segment's Default package (one per segment): used by everyone without an assignment.
  defaultFor  Segment?                @unique
  status      PackageStatus           @default(ACTIVE)
  /// Converted from the old pricing: "rate-card:<segment>", "plan:<id>", "tariff:<merchantId>".
  source      String?                 @unique
  createdById String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    ServicePackageVersion[]
  assignments PackageAssignment[]

  @@unique([segment, name])
  @@map("service_packages")
}

/// Immutable services and prices of a package from `effectiveFrom` (the latest one not in the future applies).
model ServicePackageVersion {
  id              String         @id @default(uuid(7)) @db.Uuid
  packageId       String         @db.Uuid
  version         Int
  /// Enabled service codes (SERVICES in packages/shared).
  services        String[]
  /// Message channels switched off per message: "notify.booked:sms" (code:channel; sms, email or push). Empty = every channel.
  notificationChannelsOff String[] @default([])
  /// packagePricesSchema (packages/shared).
  prices          Json
  effectiveFrom   DateTime       @default(now())
  note            String?
  createdById     String?        @db.Uuid
  /// The maker-checker change request that made it, if any.
  changeRequestId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  package         ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  parcels         Parcel[]

  @@unique([packageId, version])
  @@index([packageId, effectiveFrom])
  @@map("service_package_versions")
}

/// A merchant's package from `effectiveFrom` (packageId null = back to the segment default).
model PackageAssignment {
  id            String          @id @default(uuid(7)) @db.Uuid
  merchantId    String          @db.Uuid
  packageId     String?         @db.Uuid
  effectiveFrom DateTime        @default(now())
  note          String?
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now())
  merchant      Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  package       ServicePackage? @relation(fields: [packageId], references: [id])

  @@index([merchantId, effectiveFrom])
  @@index([packageId])
  @@map("package_assignments")
}

/// Hubs that count as one city for pricing (same-city tier), e.g. "Dhaka City".
model HubGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hubs        Hub[]

  @@map("hub_groups")
}

/// Products merchants book (required when the segment has any): e-commerce (dress, toy…) or document (credit card…).
model ParcelProduct {
  id                 String   @id @default(uuid(7)) @db.Uuid
  segment            Segment
  name               String
  /// Fixed product type: REGULAR | DOCUMENT | BOOKS (packages/shared PRODUCT_TYPES); it prices the parcel.
  type               String   @default("REGULAR")
  active             Boolean  @default(true)
  /// "Send SMS & email for this product": false = no parcel messages at all for its parcels (booked
  /// with an empty `Parcel.notifications`). Which messages go is chosen per parcel at booking.
  sendMessages       Boolean  @default(true)
  /// The category it is listed under (its messages: the category's channels).
  categoryId         String?  @db.Uuid
  category           ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder          Int      @default(0)
  /// Created by the AI import (Operational settings › AI import): the merchant's name for a product not in the list.
  aiCreated          Boolean  @default(false)
  /// Where its parcels' messages go (SMS, email, push): off sends nothing on that channel for its parcels.
  notifySms          Boolean  @default(true)
  notifyEmail        Boolean  @default(true)
  notifyPush         Boolean  @default(true)
  /// DEPRECATED (2026-10-17, replaced by `sendMessages`): no longer read or written. Kept only because
  /// the schema lock refuses data-dropping migrations; drop it with a reviewed migration.
  mutedNotifications String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  parcels            Parcel[]

  @@unique([segment, name])
  @@map("parcel_products")
}

/// A product category (super admin › Operational settings › Product categories). Customer & E-commerce share the
/// ECOMMERCE list; Banking & Financial has its own. Its channels decide which messages its parcels may get: a channel
/// that is off sends nothing, whatever the booking ticked.
model ProductCategory {
  id          String          @id @default(uuid(7)) @db.Uuid
  segment     Segment
  name        String
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  notifySms   Boolean         @default(true)
  notifyEmail Boolean         @default(true)
  notifyPush  Boolean         @default(true)
  /// Created by the AI import (its channels set from the super admin's channel prompt).
  aiCreated   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    ParcelProduct[]
  parcels     Parcel[]

  @@unique([segment, name])
  @@map("product_categories")
}

/// A parcel priority: a tag (no charge) chosen at booking and import, filtered in the parcel lists. One list per
/// category (ECOMMERCE for Customer & E-commerce, BANKING_FINANCIAL); `isDefault` is preselected.
model ParcelPriority {
  id        String   @id @default(uuid(7)) @db.Uuid
  segment   Segment
  name      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parcels   Parcel[]

  @@unique([segment, name])
  @@map("parcel_priorities")
}

/// A delivery type (Regular, Express, 4 Hour, Same Day…: super admin › Operational settings › Delivery types). Its
/// + charge is set per package version (prices.deliveryFees[code]). `segments` lists the categories it is offered to;
/// `slaLevel` picks the SLA policies that time it. `code` is stored on parcels (speedOption) and never changes.
model DeliveryType {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique
  name      String
  segments  Segment[]
  slaLevel  ServiceLevel @default(REGULAR)
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("delivery_types")
}
